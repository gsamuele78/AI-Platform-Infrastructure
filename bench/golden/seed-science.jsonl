// Seed science/format tasks. NOT the research golden set: the research lead adds >= 40 real prompts as research-*.jsonl (PLAN P5).
{"id": "sci-shannon", "messages": [{"role": "user", "content": "Compute the Shannon diversity index H' (natural log) for a community with species proportions 0.5, 0.25, 0.25. Give the number to 3 decimals."}], "check": {"number": {"value": 1.04, "tol": 0.002}}}
{"id": "sci-simpson-it", "messages": [{"role": "user", "content": "Calcola l'indice di Simpson 1-D (D = somma delle p_i al quadrato) per proporzioni 0.5, 0.3, 0.2. Riporta il valore con 2 decimali."}], "check": {"number": {"value": 0.62, "tol": 0.005}}}
{"id": "sci-r-code", "messages": [{"role": "user", "content": "Write R code using vegan to compute Shannon diversity per row of a community matrix `comm`. Only the code."}], "check": {"contains_all": ["vegan", "diversity("], "regex": "shannon"}}
{"id": "sci-python-code", "messages": [{"role": "user", "content": "Write a Python function `logistic(N, r, K)` returning the logistic growth rate dN/dt. Only the code."}], "check": {"regex": "def\\s+logistic\\s*\\(\\s*N\\s*,\\s*r\\s*,\\s*K\\s*\\)", "contains_all": ["return"], "contains_any": ["(1 - N / K)", "(1-N/K)", "1 - N/K", "(K - N) / K"]}}
{"id": "sci-taxonomy", "messages": [{"role": "user", "content": "To which order and family does the European hornet (Vespa crabro) belong?"}], "check": {"contains_all": ["Hymenoptera", "Vespidae"]}}
{"id": "sci-units", "messages": [{"role": "user", "content": "A plot is 25 m by 40 m. How many hectares is it? Give just the number."}], "check": {"number": {"value": 0.1, "tol": 0.0001}}}
{"id": "sci-it-answer", "messages": [{"role": "user", "content": "Rispondi in italiano: cos'è la biodiversità alfa? Una frase."}], "check": {"contains_any": ["diversità", "specie"], "regex": "\\b(è|la|di|delle|in)\\b"}}
{"id": "sci-citation-format", "messages": [{"role": "user", "content": "Format this reference in APA 7: authors Smith, J. and Rossi, M.; year 2020; title 'Pollinator decline in the Alps'; journal Ecology Letters; volume 23; pages 101-110."}], "check": {"regex": "Smith,\\s*J\\.,?\\s*(&|and)\\s*Rossi,\\s*M\\.\\s*\\(2020\\)\\.", "contains_all": ["Ecology Letters", "23", "101"]}}
{"id": "sci-stats", "messages": [{"role": "user", "content": "In a t-test with p = 0.03 and alpha = 0.05, do we reject the null hypothesis? Answer yes or no first."}], "check": {"regex": "^\\W*(yes|sì|si)\\b"}}
{"id": "sci-extraction", "messages": [{"role": "user", "content": "Extract as JSON with keys site, date, species_count from: 'At site Monte Cimone on 2024-06-12 we recorded 37 species.' JSON only."}], "check": {"json_keys": ["site", "date", "species_count"], "contains_all": ["Monte Cimone", "2024-06-12", "37"]}}
