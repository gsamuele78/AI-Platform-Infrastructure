# Non-secret release configuration (committed, reviewed in PRs, snapshotted by
# scripts/deploy/deploy.sh with every release). Secrets live in .env.

# Model: Qwen2.5-72B-Instruct, FP8 W8A8 (compressed-tensors). The repo id
# "Qwen/Qwen2.5-72B-Instruct-FP8" used previously does not exist on Hugging Face.
# Revision pins the exact weights; change it only through a reviewed PR.
MODEL_ID=RedHatAI/Qwen2.5-72B-Instruct-FP8-dynamic
MODEL_REVISION=4d9910ef10cf92b072dad8ce7c2a2929fac4fe0f
# Stable alias that clients use; it survives model swaps and is identical in
# every profile, so configs/proxy/config.yaml never changes per environment.
SERVED_MODEL_NAME=lifewatch-chat
MODEL_CACHE_DIR=/data/vllm_cache

# Capacity (see docs/requirements/PRD.md section 2): weights are 75.2 GB, leaving
# roughly 6-8 GiB for KV cache across both L40S at 0.90 utilisation. With a BF16
# KV cache even ONE 32k-token sequence does not fit and vLLM refuses to start.
# FP8 KV halves it to 160 KiB/token: about 40-50k cached tokens in total.
VLLM_GPU_COUNT=2
VLLM_TENSOR_PARALLEL_SIZE=2
VLLM_MAX_MODEL_LEN=16384
VLLM_KV_CACHE_DTYPE=fp8
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_NUM_SEQS=32
