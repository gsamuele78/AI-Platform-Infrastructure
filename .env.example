# Copy to .env, then: chmod 600 .env
# Every CHANGE_ME must be replaced; scripts/deploy/preflight.sh refuses to deploy otherwise.
# Generate secrets with: openssl rand -hex 32   (hex keeps them URL-safe for DATABASE_URL)

# LiteLLM admin key. Must start with "sk-". Used only by operators and scripts,
# never given to Open WebUI or end users.
LITELLM_MASTER_KEY=sk-CHANGE_ME

# Shared secret between LiteLLM and vLLM (defence in depth on the internal network).
VLLM_API_KEY=CHANGE_ME

# Scoped LiteLLM virtual key used by Open WebUI. Leave empty for the first deploy,
# then create it with: scripts/ops/issue-key.sh --alias open-webui
OPENWEBUI_API_KEY=

# PostgreSQL (LiteLLM state + audit). Password must be URL-safe: [A-Za-z0-9._~-]
POSTGRES_USER=litellm
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=litellm

# Open WebUI session signing key. Must be stable across restarts.
WEBUI_SECRET_KEY=CHANGE_ME
# Public URL users reach through the TLS ingress. Must be https://PUBLIC_HOSTNAME.
WEBUI_URL=https://ai.example.lifewatch.eu

# ---- Host settings (not secrets, but specific to this machine) ----------------
# DNS name of the platform; the TLS certificate is issued for it.
PUBLIC_HOSTNAME=ai.example.lifewatch.eu
# Optional extra certificate names for the self-signed phase, e.g. IP:10.0.0.5,DNS:ai.lan
TLS_EXTRA_SANS=
# TLS material (live/, ca/, letsencrypt/, acme-webroot/). Root-owned, 0700.
TLS_DIR=/etc/lifewatch/tls
# Backups go here. Make it a DEDICATED MOUNT (separate disk now, NFS/CIFS share
# later) so backups survive the root filesystem and can be exported.
BACKUP_DIR=/srv/lifewatch-backups
# true = refuse to deploy unless BACKUP_DIR is a mountpoint.
BACKUP_REQUIRE_MOUNT=false
# Address the ingress listens on (0.0.0.0 = all interfaces).
INGRESS_BIND=0.0.0.0

# Keycloak OIDC client for Open WebUI (DEC-001).
OIDC_CLIENT_ID=lifewatch-ai-platform
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_DISCOVERY_URL=https://auth.lifewatch.eu/realms/lifewatch/.well-known/openid-configuration

# Only needed by scripts/vm/fetch-model.sh for gated weights; not passed to vLLM.
HF_TOKEN=
