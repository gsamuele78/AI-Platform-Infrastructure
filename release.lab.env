# Lab profile: one small GPU (developer laptop, e.g. RTX A2000 4 GB).
# Same images, same gateway/UI/ingress/backup path as production; only the
# model and capacity differ. Use with: LW_RELEASE_ENV=release.lab.env
# Qwen2.5-0.5B-Instruct: 0.99 GB BF16 weights, 12 KiB KV per token
# (24 layers x 2 KV heads x 64 dims x 2 (K,V) x 2 bytes).
MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
MODEL_REVISION=7ae557604adf67be50417f59c2c2f167def9a775
SERVED_MODEL_NAME=lifewatch-chat
MODEL_CACHE_DIR=/srv/lifewatch-lab/vllm_cache

VLLM_GPU_COUNT=1
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_MAX_MODEL_LEN=4096
VLLM_KV_CACHE_DTYPE=auto
VLLM_GPU_MEMORY_UTILIZATION=0.80
VLLM_MAX_NUM_SEQS=8
