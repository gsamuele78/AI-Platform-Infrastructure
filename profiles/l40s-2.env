# Profile l40s-2: two NVIDIA L40S passed through to the VM (ADR-012).
# Non-secret release configuration, committed and snapshotted by deploy.
# Selected automatically when scripts/vm/detect-profile.sh sees two L40S.
PROFILE_NAME=l40s-2
# candidate = not yet validated on the host (AC-3.1 + golden set, PLAN P5);
# preflight refuses it unless LW_ALLOW_UNVALIDATED=true.
PROFILE_STATUS=candidate
PROFILE_GPUS=2

# Same model as l40s-1, on purpose: one quality evaluation covers both
# profiles, and moving the second card (ADR-015) changes capacity, not answers.
# The second GPU buys context, concurrency and per-token speed. Challengers
# measured in PLAN P5: the same model with data parallelism (2 replicas,
# no NCCL), and Qwen3.6-35B-A3B FP8 (3B active, faster decode).
# See docs/plan/MODEL_SELECTION.md.
MODEL_ID=Qwen/Qwen3.8-27B-FP8
MODEL_REVISION=017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
SERVED_MODEL_NAME=lifewatch-chat
MODEL_CACHE_DIR=/data/vllm_cache

# Capacity (computed): TP=2 splits weights (14.4 GiB per GPU) and KV heads.
# Per GPU: 40.5 - 14.4 - ~2.5 = ~23.5 GiB for cache, ~47 GiB in total.
# 32 sequences x ~72 MiB linear state = ~2.3 GiB; the rest (~44 GiB) holds
# ~700k tokens at 64 KiB/token (BF16): 128k context with room for many users.
VLLM_GPU_COUNT=2
VLLM_TENSOR_PARALLEL_SIZE=2
VLLM_MAX_MODEL_LEN=131072
VLLM_KV_CACHE_DTYPE=auto
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_NUM_SEQS=32

VLLM_TOOL_CALL_PARSER=qwen3_coder
VLLM_REASONING_PARSER=qwen3
VLLM_CHAT_TEMPLATE_KWARGS='{"preserve_thinking": false}'
# Images on (figures, plots, scanned tables in Open WebUI); video off.
VLLM_LIMIT_MM_PER_PROMPT='{"image": 4, "video": 0}'
