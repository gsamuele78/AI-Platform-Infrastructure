# Profile lab: one small GPU (developer laptop, e.g. RTX A2000 4 GB).
# Same images, gateway, UI, ingress and backup path as production. The model
# is the smallest one with the production architecture (Qwen3.5: hybrid
# attention, thinking, qwen3_coder tool calls), so the lab exercises the same
# vLLM code paths and parsers. Used by tests/lab/run-gpu.sh, never detected.
PROFILE_NAME=lab
PROFILE_STATUS=lab
PROFILE_GPUS=1

# Qwen3.5-0.8B: 1.75 GB BF16. Per token: 6 full-attention layers x 2 x 2 KV
# heads x 256 x 2 B = 12 KiB; per sequence: 18 linear layers x 16 heads x
# 128 x 128 x 2 B = ~9 MiB of state.
MODEL_ID=Qwen/Qwen3.5-0.8B
MODEL_REVISION=2fc06364715b967f1860aea9cf38778875588b17
SERVED_MODEL_NAME=lifewatch-chat
MODEL_CACHE_DIR=/srv/lifewatch-lab/vllm_cache

VLLM_GPU_COUNT=1
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_MAX_MODEL_LEN=8192
VLLM_KV_CACHE_DTYPE=auto
VLLM_GPU_MEMORY_UTILIZATION=0.80
VLLM_MAX_NUM_SEQS=8

VLLM_TOOL_CALL_PARSER=qwen3_coder
VLLM_REASONING_PARSER=qwen3
VLLM_CHAT_TEMPLATE_KWARGS='{"preserve_thinking": false}'
VLLM_LIMIT_MM_PER_PROMPT='{"image": 0, "video": 0}'
