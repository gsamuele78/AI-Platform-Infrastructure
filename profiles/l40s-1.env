# Profile l40s-1: one NVIDIA L40S passed through to the VM (ADR-012).
# Non-secret release configuration, committed and snapshotted by deploy.
# Selected automatically when scripts/vm/detect-profile.sh sees one L40S.
PROFILE_NAME=l40s-1
# candidate = not yet validated on the host (AC-3.1 + golden set, PLAN P5);
# preflight refuses it unless LW_ALLOW_UNVALIDATED=true.
PROFILE_STATUS=candidate
PROFILE_GPUS=1

# Model: Qwen3.8-27B FP8 (dense 27B, hybrid attention: 16 of 64 layers keep a
# per-token KV cache, 48 use linear attention). Apache-2.0. Chosen over
# Qwen3.6-35B-A3B (37.5 GB: too little KV left on one GPU) and Gemma 4
# 26B-A4B / 31B on vendor-reported scores (docs/plan/MODEL_SELECTION.md).
# Unverified until PLAN P5 measures it on the L40S.
MODEL_ID=Qwen/Qwen3.8-27B-FP8
MODEL_REVISION=017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
# Stable alias for every profile: clients never change (ADR-014).
SERVED_MODEL_NAME=lifewatch-chat
MODEL_CACHE_DIR=/data/vllm_cache

# Capacity (computed, PRD section 2): budget 0.90 x 45.0 GiB = 40.5 GiB;
# weights 30.9 GB = 28.8 GiB; activations and CUDA graphs ~2-3 GiB (estimate)
# -> ~9-10 GiB for cache. Per token (BF16): 16 layers x 2 x 4 KV heads x 256
# x 2 B = 64 KiB. Per running sequence: linear-attention state 48 layers x
# 48 heads x 128 x 128 x 2 B = ~72 MiB, so 16 sequences hold ~1.2 GiB.
# Leaves ~8 GiB = ~130k cacheable tokens: two 64k requests, or many short ones.
VLLM_GPU_COUNT=1
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_MAX_MODEL_LEN=65536
VLLM_KV_CACHE_DTYPE=auto
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_NUM_SEQS=16

# Model family settings (Qwen3.5 architecture; same parsers as the Qwen3.6
# model card, to be confirmed in the lab with Qwen3.5-0.8B).
VLLM_TOOL_CALL_PARSER=qwen3_coder
VLLM_REASONING_PARSER=qwen3
# Thinking stays on (per request: chat_template_kwargs.enable_thinking=false);
# old thinking blocks are dropped from history so chats do not fill the
# context. Agents that want them back send preserve_thinking=true.
VLLM_CHAT_TEMPLATE_KWARGS='{"preserve_thinking": false}'
# Text only on one GPU: no memory reserved for the vision encoder.
VLLM_LIMIT_MM_PER_PROMPT='{"image": 0, "video": 0}'
