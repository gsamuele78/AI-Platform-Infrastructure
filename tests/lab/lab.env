# Lab secrets for tests/lab/run-gpu.sh on a developer laptop. NOT real credentials.
LITELLM_MASTER_KEY=sk-lab-master-000000000000000000000000000000
VLLM_API_KEY=lab-vllm-key-0000000000000000000000000000
OPENWEBUI_API_KEY=
POSTGRES_USER=litellm
POSTGRES_PASSWORD=lab-postgres-password-00000
POSTGRES_DB=litellm
WEBUI_SECRET_KEY=lab-webui-secret-00000000000000000000000
WEBUI_URL=https://localhost:8444
# Lab only: allow a local admin account (no Keycloak on a laptop).
WEBUI_ENABLE_SIGNUP=true
OIDC_CLIENT_ID=lab
OIDC_CLIENT_SECRET=lab-oidc-secret-not-used
OIDC_DISCOVERY_URL=https://auth.invalid/realms/lab/.well-known/openid-configuration
HF_TOKEN=
PUBLIC_HOSTNAME=localhost
TLS_EXTRA_SANS=IP:127.0.0.1
TLS_DIR=/overridden/by/run-gpu.sh
BACKUP_DIR=/overridden/by/run-gpu.sh
BACKUP_REQUIRE_MOUNT=false
INGRESS_BIND=127.0.0.1
# Unprivileged ports so rootless Podman can bind them (no sysctl change).
INGRESS_HTTP_PORT=8081
INGRESS_HTTPS_PORT=8444
INGRESS_API_PORT=8445
INGRESS_REDIRECT_AUTHORITY=localhost:8444
