#!/usr/bin/env bats
# tests/lab/setup.sh: every lab prerequisite checked in phases, all problems
# listed at once; --apply fixes only toolkit, CDI spec and LAB_DIR, idempotently.

load ../helpers/common

SCRIPT="${BATS_TEST_DIRNAME}/../../tests/lab/setup.sh"
DRIVER=595.91.07

setup() {
  setup_sandbox
  export LAB_DIR="${SANDBOX}/lab" LW_CDI_SPEC="${SANDBOX}/cdi/nvidia.yaml"
  export LW_SUBID_FILES="${SANDBOX}/subuid ${SANDBOX}/subgid"
  export LW_LAB_FIRST_RUN_GB=1 LW_LAB_RERUN_GB=1 SUDO_USER="$(/usr/bin/id -un)"
  echo "${SUDO_USER}:100000:65536" | tee "${SANDBOX}/subuid" >"${SANDBOX}/subgid"
  stub nvidia-smi "echo 'NVIDIA RTX A2000 Laptop GPU, 4096, ${DRIVER}'"
  stub podman 'echo "podman version 5.4.2"'
  stub ss ''
  stub apt-cache 'echo "  Candidate: 1.20.1-1"'
  # Installing the toolkit makes nvidia-ctk appear. Like the real one, the
  # generated spec names the driver currently loaded (library paths).
  cat >"${SANDBOX}/nvidia-ctk.impl" <<'IMPL'
#!/usr/bin/env bash
echo "nvidia-ctk $*" >>"$STUB_LOG"
case "$1" in
  --version) echo "NVIDIA Container Toolkit CLI version 1.20.1" ;;
  cdi) echo "libcuda.so.$(nvidia-smi | awk -F', ' '{print $3}')" >"${3#--output=}" ;;
esac
IMPL
  stub apt-get '[[ " $* " == *" install "* ]] && install -m 0755 "$SANDBOX/nvidia-ctk.impl" "$STUB_BIN/nvidia-ctk"; exit 0'
}

all_present() {
  as_root
  bash "${SCRIPT}" --apply >/dev/null 2>&1
  as_user
  : >"${STUB_LOG}"
}

@test "check mode lists every missing item at once and changes nothing" {
  run bash "${SCRIPT}"
  assert_failure
  assert_output_contains "[8/8]"
  assert_output_contains "nvidia-ctk not found"
  assert_output_contains "no CDI spec"
  assert_output_contains "missing or not owned"
  assert_output_contains "3 problem(s) left"
  not_called apt-get
  [[ ! -e "${LAB_DIR}" && ! -e "${LW_CDI_SPEC}" ]]
}

@test "--apply refuses to run without root" {
  as_user
  run bash "${SCRIPT}" --apply
  assert_status 2
  assert_output_contains "sudo"
  not_called apt-get
}

@test "--apply installs the toolkit, generates the CDI spec, creates LAB_DIR for the invoking user" {
  as_root
  run bash "${SCRIPT}" --apply
  assert_status 0
  assert_output_contains "Lab ready (3 item(s) fixed now)"
  called apt-get "install -y -q nvidia-container-toolkit"
  called nvidia-ctk "cdi generate --output=${LW_CDI_SPEC}"
  [[ "$(stat -c '%U %a' "${LAB_DIR}")" == "${SUDO_USER} 700" ]]
  assert_output_contains "WITHOUT sudo"
}

@test "a second --apply changes nothing (idempotent)" {
  all_present
  as_root
  run bash "${SCRIPT}" --apply
  assert_status 0
  [[ "${output}" != *"done now"* ]]
  not_called apt-get
  refute called nvidia-ctk "cdi generate"
}

@test "a CDI spec from an older driver is reported, and regenerated by --apply" {
  all_present
  echo 'libcuda.so.580.65.06' >"${LW_CDI_SPEC}"
  as_user
  run bash "${SCRIPT}"
  assert_failure
  assert_output_contains "another driver"
  as_root
  run bash "${SCRIPT}" --apply
  assert_status 0
  grep -q "${DRIVER}" "${LW_CDI_SPEC}"
}

@test "an old driver, too little disk and a busy port are reported, never 'fixed'" {
  all_present
  stub nvidia-smi "echo 'NVIDIA RTX A2000 Laptop GPU, 4096, 570.10.01'"
  stub ss '[[ "$*" == *8444* ]] && echo "LISTEN 0 4096 127.0.0.1:8444 0.0.0.0:*"; exit 0'
  as_root
  run env LW_LAB_RERUN_GB=999999 LW_LAB_FIRST_RUN_GB=999999 bash "${SCRIPT}" --apply
  assert_failure
  assert_output_contains "driver 570.10.01 < 580"
  assert_output_contains "need 999999 GB"
  assert_output_contains "in use: 8444"
  assert_output_contains "3 problem(s) left"
  not_called apt-get
}

@test "the disk hint never suggests a cloud-sync or backup mount" {
  run env LW_LAB_FIRST_RUN_GB=999999 bash "${SCRIPT}"
  [[ "${output}" != *onedrive* && "${output}" != *TimeShift* ]]
}

@test "make lab-gpu refuses to run as root with rootless Podman" {
  as_root
  run bash "${REPO_ROOT}/tests/lab/run-gpu.sh"
  assert_status 2
  assert_output_contains "WITHOUT sudo"
}

@test "make lab-gpu stops before touching anything when prerequisites are missing" {
  as_user
  run bash "${REPO_ROOT}/tests/lab/run-gpu.sh"
  assert_failure
  assert_output_contains "sudo make lab-setup"
  refute called podman "system service" # no lab engine started
  [[ ! -e "${LAB_DIR}" ]]
}
